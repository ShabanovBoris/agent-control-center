{
  "name": "agent-control-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "host": "bash scripts/start-host.sh",
    "host:gemini": "node --import tsx scripts/start-gemini-host.ts",
    "update:agents": "node scripts/update-agents.mjs",
    "restart:services": "node --import tsx scripts/restart-services.ts",
    "server": "tsx server/index.ts",
    "web": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "tsx --test server/*.test.ts src/*.test.ts"
  },
  "dependencies": {
    "@microsoft/agent-host-protocol": "^1.1.0",
    "diff": "9.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
