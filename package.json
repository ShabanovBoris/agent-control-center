{
  "name": "agent-control-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "host": "bash scripts/start-host.sh",
    "host:gemini": "node --import tsx scripts/start-gemini-host.ts",
    "update:agents": "node scripts/update-agents.mjs",
    "restart:services": "node --import tsx scripts/restart-services.ts",
    "up": "node --import tsx scripts/up.ts",
    "server": "tsx server/index.ts",
    "server:dev": "ACC_CONFIG=hosts.dev.json ACC_PHONE_ACCESS=0 tsx server/index.ts",
    "server:e2e": "ACC_CONFIG=hosts.e2e.json ACC_PHONE_ACCESS=0 tsx server/index.ts",
    "mock-host": "tsx scripts/mock-host.ts",
    "web": "vite",
    "web:dev": "ACC_BACKEND=${ACC_BACKEND:-127.0.0.1:8095} vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && tsc -p tsconfig.e2e.json",
    "test": "tsx --test server/*.test.ts src/*.test.ts",
    "pretest:e2e": "playwright install chromium",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@microsoft/agent-host-protocol": "^1.1.0",
    "diff": "9.0.0",
    "hast-util-to-jsx-runtime": "2.3.7",
    "highlight.js": "11.11.2",
    "lowlight": "3.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "web-push": "4.0.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/hast": "3.0.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
